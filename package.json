{
  "name": "ai-vtt",
  "version": "0.2.0",
  "description": "Self-hosted D&D 5e virtual tabletop with an AI Dungeon Master",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "test:browser": "node --experimental-websocket --test --test-concurrency=1 --test-reporter=spec test/browser/browser.test.mjs test/browser/maptest.test.mjs test/browser/wizard.test.mjs test/browser/voice.test.mjs",
    "dm-check": "node scripts/dm-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.0"
  }
}
