ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PORT=3000

# Optional: natural character voices (OpenAI text-to-speech). Leave blank to use browser voices.
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
# OPENAI_IMAGE_API_KEY= (optional: a separate key for the map pictures; blank means OPENAI_API_KEY is used)
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium

# Network interface to listen on. 127.0.0.1 = this computer only. Use 0.0.0.0 to let other devices join (settings stay local-only).
HOST=127.0.0.1
