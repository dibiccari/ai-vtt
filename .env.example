ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PORT=3000

# Optional: natural character voices (OpenAI text-to-speech). Leave blank to use browser voices.
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
# OPENAI_IMAGE_API_KEY= (optional: a separate key for the map pictures; blank means OPENAI_API_KEY is used)
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
# GEMINI_API_KEY= and FAL_API_KEY= are only needed for the image bake-off or if you pick that provider
IMAGE_QUALITY=medium

# Network interface to listen on. 127.0.0.1 = this computer only. Use 0.0.0.0 to let other devices join (settings stay local-only).
HOST=127.0.0.1

# The Dungeon Master (Settings > Dungeon Master)
# DM_PROVIDER=claude          # or none: a person runs the game
# DM_EFFORT=low               # low | medium | high: how hard it thinks before it answers (low is fastest)
# DM_SPEED=fast               # fast | standard: Opus models write about 2.5 times faster in fast mode, at twice the price

# Voices (Settings > Dungeon Master voice, NPC voices)
# VOICE_PROVIDER=openai       # openai | browser | none: the Dungeon Master's own voice
# DM_VOICE=fable              # a ChatGPT voice for the Dungeon Master
# NPC_VOICE_PROVIDER=openai   # openai | browser | none: the characters the Dungeon Master plays
# NPC_TTS_MODEL=gpt-4o-mini-tts-2025-03-20
